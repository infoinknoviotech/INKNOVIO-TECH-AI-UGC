PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
SMTP_USER=your-smtp-account@example.com
SMTP_PASS=your-16-character-gmail-app-password
# Set these for non-Gmail SMTP providers. Leave blank when using Gmail above.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=your-smtp-account@example.com
LEAD_RECIPIENT=your-admin@example.com
AUTH_NOTIFICATION_RECIPIENT=your-admin@example.com
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+15551234567
