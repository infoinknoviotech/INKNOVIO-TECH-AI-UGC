{
  "version": 2,
  "rewrites": [
    { "source": "/app.js", "destination": "/api/index.js" },
    { "source": "/code.html", "destination": "/api/index.js" },
    { "source": "/screen.png", "destination": "/api/index.js" },
    { "source": "/assets/(.*)", "destination": "/api/index.js" },
    { "source": "/uploads/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/api/index.js" }
  ]
}
